# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- locale / fees ----------------------------------------------------
HOME_ZIP=08055
SALES_TAX_RATE=0.06625
DEFAULT_BUYERS_PREMIUM=0.15
PICKUP_COST=0

# ---- valuation --------------------------------------------------------
# Required net margin before a lot is recommended. 0.40 = 40%.
TARGET_MARGIN=0.40
LABOR_RATE_PER_HOUR=25
MIN_PROFIT_DOLLARS=20

# ---- exposure control -------------------------------------------------
# The most you can be on the hook for across all simultaneously-open bids.
MAX_OPEN_EXPOSURE=1500
MAX_OPEN_LOTS=25
MAX_PER_CATEGORY_EXPOSURE=500

# ---- eBay comps (optional) --------------------------------------------
# Free dev account: https://developer.ebay.com/
# NOTE: Marketplace Insights (true SOLD comps) requires partner approval.
# Without it we use Browse API active listings, which runs optimistic.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_FEE_RATE=0.1325

# Optional third-party local-comps feed (RSS/JSON).
# Craigslist discontinued native RSS, so this is bring-your-own if you want it.
LOCAL_COMPS_FEED_URL=

# ---- email notifications ----------------------------------------------
# Gmail: use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
NOTIFY_MIN_PROFIT=25

# ---- ingestion politeness ---------------------------------------------
# Raising the rate is how you get IP-blocked. Leave these alone unless you
# know what you're doing.
REQUEST_DELAY_SECONDS=2.5
MAX_REQUESTS_PER_RUN=400
ENABLE_BROWSER_FALLBACK=false

# ---- browser price lookups ---------------------------------------------
# Retail verification runs through your own browser: the extension opens a
# search page you could have opened by hand, reads the prices, closes the tab.
# None of these sites offer a usable price API (Amazon's needs an Associate
# account with qualifying sales, Walmart's needs partner approval, Facebook
# Marketplace has none), so this is the route that needs no credentials.
#
# The defaults are pedestrian on purpose — a few searches an hour, one at a
# time. Turning them up is how you get a CAPTCHA and lose the feature entirely.
LOOKUP_ENABLED=true
LOOKUP_SITES=amazon,walmart,facebook
LOOKUP_MIN_SECONDS_BETWEEN=45
LOOKUP_SITE_MIN_SECONDS=180
LOOKUP_MAX_PER_DAY=120
# When a site shows a CAPTCHA we back that site off entirely for this long.
# Nothing solves it or retries around it.
LOOKUP_BLOCK_COOLDOWN_MINUTES=360
# Re-check a price once it's older than this.
MARKET_PRICE_TTL_DAYS=21
# Search URLs, so a site changing its scheme is an edit here, not a code change.
# AMAZON_SEARCH_TEMPLATE=https://www.amazon.com/s?k={q}
# WALMART_SEARCH_TEMPLATE=https://www.walmart.com/search?q={q}
# FACEBOOK_SEARCH_TEMPLATE=https://www.facebook.com/marketplace/search/?query={q}&radius_km=24

# ---- web / extension ---------------------------------------------------
WEB_PORT=8787
# Shared secret the Chrome extension sends. Generate: openssl rand -hex 24
API_TOKEN=
